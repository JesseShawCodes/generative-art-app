{
  "openapi": "3.1.0",
  "info": {
    "title": "Generative Art API",
    "version": "0.1.0"
  },
  "paths": {
    "/generate-art": {
      "post": {
        "tags": [
          "generation"
        ],
        "summary": "Generate Art Endpoint",
        "operationId": "generate_art_endpoint_generate_art_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtGenerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtGenerationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Algorithm": {
        "type": "string",
        "enum": [
          "circles",
          "flow_field",
          "geometric",
          "particles"
        ],
        "title": "Algorithm"
      },
      "ArtGenerationRequest": {
        "properties": {
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "default": "circles"
          },
          "width": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 100.0,
            "title": "Width",
            "default": 800
          },
          "height": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 100.0,
            "title": "Height",
            "default": 600
          },
          "num_elements": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Num Elements",
            "default": 50
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          }
        },
        "type": "object",
        "title": "ArtGenerationRequest"
      },
      "ArtGenerationResponse": {
        "properties": {
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm"
          },
          "seed": {
            "type": "integer",
            "title": "Seed"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "elements": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/CircleElement"
                },
                {
                  "$ref": "#/components/schemas/LineElement"
                },
                {
                  "$ref": "#/components/schemas/PolygonElement"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "circle": "#/components/schemas/CircleElement",
                  "line": "#/components/schemas/LineElement",
                  "polygon": "#/components/schemas/PolygonElement"
                }
              }
            },
            "type": "array",
            "title": "Elements"
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "seed",
          "width",
          "height",
          "elements"
        ],
        "title": "ArtGenerationResponse"
      },
      "CircleElement": {
        "properties": {
          "type": {
            "type": "string",
            "const": "circle",
            "title": "Type",
            "default": "circle"
          },
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          },
          "radius": {
            "type": "number",
            "title": "Radius"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "opacity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "radius",
          "color"
        ],
        "title": "CircleElement"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "HealthResponse"
      },
      "LineElement": {
        "properties": {
          "type": {
            "type": "string",
            "const": "line",
            "title": "Type",
            "default": "line"
          },
          "x1": {
            "type": "number",
            "title": "X1"
          },
          "y1": {
            "type": "number",
            "title": "Y1"
          },
          "x2": {
            "type": "number",
            "title": "X2"
          },
          "y2": {
            "type": "number",
            "title": "Y2"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "thickness": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Thickness",
            "default": 1.0
          },
          "opacity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2",
          "color"
        ],
        "title": "LineElement"
      },
      "Point": {
        "properties": {
          "x": {
            "type": "number",
            "title": "X"
          },
          "y": {
            "type": "number",
            "title": "Y"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "title": "Point"
      },
      "PolygonElement": {
        "properties": {
          "type": {
            "type": "string",
            "const": "polygon",
            "title": "Type",
            "default": "polygon"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "minItems": 3,
            "title": "Points"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "filled": {
            "type": "boolean",
            "title": "Filled",
            "default": true
          },
          "opacity": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Opacity",
            "default": 1.0
          }
        },
        "type": "object",
        "required": [
          "points",
          "color"
        ],
        "title": "PolygonElement"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
