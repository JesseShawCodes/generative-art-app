{
  "openapi": "3.1.0",
  "info": {
    "title": "Generative Art API",
    "version": "0.1.0"
  },
  "paths": {
    "/generate-art": {
      "post": {
        "tags": [
          "generation"
        ],
        "summary": "Generate Art",
        "operationId": "generate_art_generate_art_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtGenerationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Circle"
                  },
                  "type": "array",
                  "title": "Response Generate Art Generate Art Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtGenerationRequest": {
        "properties": {
          "width": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 100.0,
            "title": "Width",
            "default": 800
          },
          "height": {
            "type": "integer",
            "maximum": 4000.0,
            "minimum": 100.0,
            "title": "Height",
            "default": 600
          },
          "num_elements": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Num Elements",
            "default": 50
          }
        },
        "type": "object",
        "title": "ArtGenerationRequest"
      },
      "Circle": {
        "properties": {
          "x": {
            "type": "integer",
            "title": "X"
          },
          "y": {
            "type": "integer",
            "title": "Y"
          },
          "radius": {
            "type": "integer",
            "title": "Radius"
          },
          "color": {
            "type": "string",
            "title": "Color"
          }
        },
        "type": "object",
        "required": [
          "x",
          "y",
          "radius",
          "color"
        ],
        "title": "Circle"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
